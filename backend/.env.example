# Copy to backend/.env and adjust for your environment.

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Fernet key for encrypting provider tokens at rest (the vault).
# Generate a new one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HUB_FIELD_ENCRYPTION_KEY=AYzC9Ly7dJjvbqyGZgBtoGN0uYauInqlZ04CBK1oZkA=

# JWT lifetimes
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Brokered provider access-token lifetime (seconds)
ACCESS_TOKEN_TTL_SECONDS=3600

# URLs used to build OAuth redirects. MUST include the scheme (https://) in production — a
# scheme-less BACKEND_BASE_URL makes Google/Meta reject sign-in with Error 400: invalid_request.
#   deployed example: BACKEND_BASE_URL=https://hub187.pythonanywhere.com
#                     FRONTEND_BASE_URL=https://187n-hub.vercel.app
BACKEND_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173

# CORS
CORS_ALLOW_ALL=true

# ---------------------------------------------------------------------------
# Real provider credentials. Providers are LIVE by default (Provider.is_mock defaults to
# False), so fill these in to connect real accounts. Register the redirect URI — full URL,
# scheme included — in each provider's app console:
#   ${BACKEND_BASE_URL}/api/connections/callback
# To run a provider offline instead: python manage.py set_provider_mode <slug> --mock
# Full setup per provider: docs/setup/{google,meta,shopify}.md
# ---------------------------------------------------------------------------

# Google Ads — Google Cloud OAuth client + MCC developer token
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=      # MCC id, digits only (no dashes)
GOOGLE_ADS_API_VERSION=v21
# Optional: comma-separated OAuth scopes (blank = broad default set).
GOOGLE_SCOPES=

# Meta Ads — Meta app (Facebook Login + Marketing API). Dev mode only reaches assets owned by
# app-role users (add them under App Roles). Blank META_SCOPES = ads-only default
# (ads_read, ads_management, business_management); set the full list to reach Pages/Instagram/
# Catalog/Leads. META_CONFIG_ID only for "Facebook Login for Business".
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v21.0
META_SCOPES=
META_CONFIG_ID=

# Shopify — Partner app. Redirect must be HTTPS: no tunnel needed if the backend is already
# HTTPS (a tunnel is only for a local http backend). Declare the SAME scopes in the app config
# and Release a version. Orders/Customers scopes need Protected customer data access (instant on
# a dev store). Blank SHOPIFY_SCOPES = broad read+write default. Use a currently-supported API
# version (2025-01 may be past Shopify's ~12-month support window).
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2026-01
SHOPIFY_SCOPES=
