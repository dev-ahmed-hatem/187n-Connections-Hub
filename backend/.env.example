# Copy to backend/.env and adjust for your environment.

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Fernet key for encrypting provider tokens at rest (the vault).
# Generate a new one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HUB_FIELD_ENCRYPTION_KEY=AYzC9Ly7dJjvbqyGZgBtoGN0uYauInqlZ04CBK1oZkA=

# JWT lifetimes
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Brokered provider access-token lifetime (seconds)
ACCESS_TOKEN_TTL_SECONDS=3600

# URLs used to build OAuth redirects (mock flow)
BACKEND_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173

# CORS
CORS_ALLOW_ALL=true

# ---------------------------------------------------------------------------
# Real provider credentials (only needed when a provider's is_mock is False).
# Register the redirect URI in each provider's app console:
#   ${BACKEND_BASE_URL}/api/connections/callback
# Leave blank to keep a provider on the mock adapter.
# ---------------------------------------------------------------------------

# Google Ads — Google Cloud OAuth client + MCC developer token
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=      # MCC id, digits only (no dashes)
GOOGLE_ADS_API_VERSION=v18

# Meta Ads — Meta app (Marketing API), ads_read scope
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v21.0
META_SCOPES=ads_read

# Shopify — Partner app (redirect URI must be HTTPS; use a tunnel locally)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2024-10
SHOPIFY_SCOPES=read_orders,read_products
