# Copy to backend/.env and adjust for your environment.

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Fernet key for encrypting provider tokens at rest (the vault).
# Generate a new one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HUB_FIELD_ENCRYPTION_KEY=AYzC9Ly7dJjvbqyGZgBtoGN0uYauInqlZ04CBK1oZkA=

# JWT lifetimes
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Brokered provider access-token lifetime (seconds)
ACCESS_TOKEN_TTL_SECONDS=3600

# URLs used to build OAuth redirects (mock flow)
BACKEND_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173

# CORS
CORS_ALLOW_ALL=true
